@using MyRezome.Models

<div id="service" class="iknow_tm_main_section">
    <div class="iknow_tm_services">
        <div class="iknow_tm_main_title">
            <span>@Profile.Labels.ServiceEyebrow</span>
            <h3>@Profile.Labels.ServiceTitle</h3>
        </div>
        <div class="service_list">
            <ul>
                @foreach (var service in Profile.Services)
                {
                    <li>
                        <div class="list_inner">
                            <span class="icon"><img class="svg" src="@service.Icon" alt="" /></span>
                            <h3 class="title">@service.Title</h3>
                            <p class="text">@service.Excerpt</p>
                            <a class="iknow_tm_full_link" data-enhance-nav="false" href="#"></a>
                            <div class="hidden_content">
                                <div class="service_informations">
                                    <div class="image">
                                        <img src="img/thumbs/4-2.jpg" alt="" />
                                        <div class="main" data-img-url="@service.Image"></div>
                                    </div>
                                    <div class="description">
                                        @foreach (var paragraph in service.Paragraphs)
                                        {
                                            <p>@paragraph</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public ResumeProfile Profile { get; set; } = default!;
}
