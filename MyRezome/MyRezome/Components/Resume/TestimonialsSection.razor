@using MyRezome.Models

<div id="testimonials" class="iknow_tm_main_section">
    <div class="iknow_tm_testimonials">
        <div class="iknow_tm_main_title">
            <span>@Profile.Labels.TestimonialsEyebrow</span>
            <h3>@Profile.Labels.TestimonialsTitle</h3>
        </div>
        <div class="testimonials_list owl-carousel owl-theme">
            @foreach (var item in Profile.Testimonials)
            {
                <div class="list_inner">
                    <div class="in">
                        <div class="text">
                            <p>@item.Quote</p>
                        </div>
                        <div class="details">
                            <div class="left">
                                <div class="avatar">
                                    <div class="main" data-img-url="@item.Avatar"></div>
                                </div>
                                <div class="info">
                                    <h3>@item.Name</h3>
                                    <span>@item.Role</span>
                                </div>
                            </div>
                            <div class="right">
                                <img class="svg" src="img/svg/left-quote.svg" alt="" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public ResumeProfile Profile { get; set; } = default!;
}
