@using MyRezome.Models

<div class="iknow_tm_topbar" data-position="absolute">
    <div class="container">
        <div class="topbar_inner">
            <div class="logo">
                <a href="@SiteCulture.Options.First(language => language.Code == Profile.Culture).Path" data-enhance-nav="false">
                    <img class="logo_on_light" src="@Profile.Logo" alt="@Profile.Name" />
                    <img class="logo_on_dark" src="img/logo/light.png" alt="" />
                </a>
            </div>
            <div class="right">
                <a class="cv_download" href="@($"/resume/{Profile.Culture}/cv.pdf")" download data-enhance-nav="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 4v11" />
                        <path d="m7 11 5 5 5-5" />
                        <path d="M5 19h14" />
                    </svg>
                    @Profile.Labels.DownloadCv
                </a>
                <div class="site_controls">
                    <label class="control_group accent_switch" title="@Profile.Labels.Accent">
                        <span class="control_icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3a9 9 0 1 0 0 18h1.2a2 2 0 0 0 1.6-3.2 2 2 0 0 1 1.6-3.2H18a3 3 0 0 0 3-3A8.8 8.8 0 0 0 12 3z" />
                                <circle cx="7.5" cy="10.5" r="1" fill="currentColor" stroke="none" />
                                <circle cx="10.2" cy="7.2" r="1" fill="currentColor" stroke="none" />
                                <circle cx="14" cy="7.2" r="1" fill="currentColor" stroke="none" />
                            </svg>
                        </span>
                        <span class="accent_well">
                            <input type="color" value="@Accent" aria-label="@Profile.Labels.Accent" />
                        </span>
                    </label>
                    <div class="control_group theme_switch" role="group" aria-label="@Profile.Labels.Theme">
                        <button type="button" data-theme="light" class="@(!IsDark ? "active" : null)" aria-pressed="@(!IsDark ? "true" : "false")" aria-label="@Profile.Labels.ThemeLight" title="@Profile.Labels.ThemeLight">
                            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                                <circle cx="12" cy="12" r="4" />
                                <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" />
                            </svg>
                        </button>
                        <button type="button" data-theme="dark" class="@(IsDark ? "active" : null)" aria-pressed="@(IsDark ? "true" : "false")" aria-label="@Profile.Labels.ThemeDark" title="@Profile.Labels.ThemeDark">
                            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
                            </svg>
                        </button>
                    </div>
                    <nav class="control_group lang_switch" aria-label="@Profile.Labels.Language">
                        <span class="control_icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M3 12h18M12 3c2.5 2.8 3.8 5.8 3.8 9s-1.3 6.2-3.8 9c-2.5-2.8-3.8-5.8-3.8-9S9.5 5.8 12 3z" />
                            </svg>
                        </span>
                        @foreach (var language in SiteCulture.Options)
                        {
                            <a href="@language.Path"
                               hreflang="@language.Code"
                               lang="@language.Code"
                               data-enhance-nav="false"
                               class="@(language.Code == Profile.Culture ? "active" : null)"
                               aria-current="@(language.Code == Profile.Culture ? "page" : null)"
                               title="@language.NativeName">@language.ShortLabel</a>
                        }
                    </nav>
                </div>
                <div class="social">
                    <ul>
                        @foreach (var link in Profile.SocialLinks)
                        {
                            <li>
                                <a href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@link.Label">
                                    <img class="svg" src="@link.Icon" alt="" />
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public ResumeProfile Profile { get; set; } = default!;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool IsDark => SiteTheme.IsDark(HttpContext?.Request.Cookies[SiteTheme.CookieName]);
    private string Accent => SiteAccent.Normalize(HttpContext?.Request.Cookies[SiteAccent.CookieName]);
}
