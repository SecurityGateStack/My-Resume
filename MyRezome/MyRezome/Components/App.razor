<!DOCTYPE html>
<html lang="@HtmlLang" dir="@HtmlDir" style="@AccentStyle">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Mulish:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="css/plugins.css" />
    <link rel="stylesheet" href="css/dark.css" />
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="css/site.css" />
    <link rel="stylesheet" href="@Assets["MyRezome.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body class="@BodyClass">
    <Routes />
    <ReconnectModal />
    <script src="js/jquery.js"></script>
    <script src="js/plugins.js"></script>
    <script src="js/init.js"></script>
    <script src="js/resume.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string Culture
    {
        get
        {
            var path = HttpContext?.Request.Path.Value ?? "/";
            var segment = path.Trim('/').Split('/', 2, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
            if (string.IsNullOrEmpty(segment) || segment is "en" or "de" or "fa")
            {
                return SiteCulture.Normalize(segment);
            }

            return SiteCulture.Normalize(HttpContext?.Request.Cookies[SiteCulture.CookieName]);
        }
    }
    private string HtmlLang => Culture;
    private string HtmlDir => SiteCulture.IsRtl(Culture) ? "rtl" : "ltr";
    private bool IsDark => SiteTheme.IsDark(HttpContext?.Request.Cookies[SiteTheme.CookieName]);
    private string AccentStyle => "--resume-accent:" + SiteAccent.Normalize(HttpContext?.Request.Cookies[SiteAccent.CookieName]);

    private string? BodyClass
    {
        get
        {
            var rtl = SiteCulture.IsRtl(Culture);
            if (rtl && IsDark)
            {
                return "rtl dark";
            }

            if (rtl)
            {
                return "rtl";
            }

            return IsDark ? "dark" : null;
        }
    }
}
